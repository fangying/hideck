[Unit]
Description=HiDeck QDC507 call-scoped audio lease broker
After=hideck-qdc507-boot-reset.service
Requires=hideck-qdc507-boot-reset.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/hideck-qdc507-audio-broker
ExecStopPost=/usr/bin/systemctl --no-block stop hideck-qdc507-audio.service
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
