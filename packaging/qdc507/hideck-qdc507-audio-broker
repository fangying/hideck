#!/usr/bin/env python3
"""Single-module, root-only Unix-socket audio leases; no network/command API."""
import os
import select
import signal
import socket
import subprocess
import threading
import time
from pathlib import Path

STATE = Path("/run/hideck-qdc507-audio")
UNIT = "hideck-qdc507-audio.service"


def log(message):
    print(message, flush=True)


def run(*args):
    return subprocess.run(args, check=True, timeout=20, capture_output=True)


def clean_route():
    run("systemctl", "stop", UNIT)
    (STATE / "ready").unlink(missing_ok=True)
    # This is a fixed command, not data received from the socket. Abort rather
    # than change routing if D4 did not close. No competing AT-port reader.
    command = (
        "{ test ! -e /proc/asound/card0/pcm4p/sub0/status || "
        "grep -q '^closed' /proc/asound/card0/pcm4p/sub0/status; } && "
        "{ test ! -e /proc/asound/card0/pcm4c/sub0/status || "
        "grep -q '^closed' /proc/asound/card0/pcm4c/sub0/status; } && "
        "echo 0 > /sys/class/android_usb/f_audio/audio_enable && "
        "{ if test -p /run/voc_svr; then "
        "printf 'T\\n' > /run/voc_svr; printf 'T\\n' > /run/voc_svr; "
        "printf 'B\\n' > /run/voc_svr; fi; } && "
        "test \"$(cat /sys/class/android_usb/f_audio/audio_enable)\" = 0")
    # Legacy adb versions omit the remote exit status; require a sentinel.
    result = run("adb", "shell", command + "; rc=$?; echo; echo ROUTE_RC:$rc")
    if result.stdout.strip().splitlines()[-1:] != [b"ROUTE_RC:0"]:
        raise RuntimeError("D4/UAC cleanup verification failed")


def disconnected(conn):
    if select.select([conn], [], [], 0)[0]:
        # EOF or any input releases the lease; there is no client command set.
        return True
    return False


class Broker:
    def __init__(self, clean=clean_route, start=None, ready=None):
        self.clean = clean
        self.start = start or (lambda: run("systemctl", "start", UNIT))
        self.ready = ready or (lambda: (STATE / "ready").is_file())
        self.lock = threading.Lock()
        self.stopping = threading.Event()

    def handle(self, conn):
        with conn:
            if not self.lock.acquire(blocking=False):
                conn.sendall(b"BUSY\n")
                return
            try:
                self.clean()
                if disconnected(conn) or self.stopping.is_set():
                    return
                self.start()
                deadline = time.monotonic() + 22
                while not self.ready():
                    if disconnected(conn) or self.stopping.wait(0.1):
                        return
                    if time.monotonic() >= deadline:
                        raise TimeoutError("audio runtime readiness timeout")
                if disconnected(conn) or self.stopping.is_set():
                    return
                conn.sendall(b"READY\n")
                log("lease ready: D4/UAC active")
                while not self.stopping.wait(0.2):
                    if disconnected(conn):
                        return
                    if not self.ready():
                        raise RuntimeError("audio runtime lost readiness")
            except Exception as exc:
                log(f"lease failed: {type(exc).__name__}: {exc}")
                try:
                    conn.sendall(b"ERROR\n")
                except OSError:
                    pass
            finally:
                try:
                    self.clean()
                    log("lease released: D4/UAC closed")
                except Exception as exc:
                    log(f"route cleanup failed: {exc}")
                self.lock.release()


def main():
    os.umask(0o077)
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    (STATE / "managed").touch()
    address = STATE / "control.sock"
    # systemd runs only one broker; flock also guards accidental manual starts.
    import fcntl
    guard = open(STATE / "broker.lock", "w")
    fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
    address.unlink(missing_ok=True)
    broker = Broker()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: broker.stopping.set())
    # Best effort on boot without an attached/initialized module. Each lease
    # performs strict cleanup before it may start a new route.
    try:
        clean_route()
    except Exception as exc:
        log(f"initial cleanup pending: {exc}")
    workers = []
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
            server.bind(str(address))
            os.chmod(address, 0o600)
            server.listen(4)
            server.settimeout(0.5)
            log("broker listening; idle route disabled")
            while not broker.stopping.is_set():
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    continue
                workers = [w for w in workers if w.is_alive()]
                worker = threading.Thread(target=broker.handle, args=(conn,))
                worker.start()
                workers.append(worker)
    finally:
        broker.stopping.set()
        for worker in workers:
            worker.join()
        try:
            clean_route()
        finally:
            address.unlink(missing_ok=True)
            # Keep managed marker: broker failure must NOT enable legacy mode.


if __name__ == "__main__":
    main()
